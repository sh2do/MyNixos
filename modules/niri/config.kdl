// Managed by Home Manager from /etc/nixos/modules/niri. Edit there, then rebuild.
// colors.kdl is generated by rice-wall (matugen) and must stay last so it wins.

include "input.kdl"
include "layout.kdl"
include "misc.kdl"
include "rules.kdl"
include "binds.kdl"
include "colors.kdl"

// Keep clipboard history for rice-menu clipboard.
spawn-sh-at-startup "wl-paste --watch cliphist store"

// The bar, top pill and wallpaper picker (modules/shell).
spawn-at-startup "qs" "-c" "rice"
