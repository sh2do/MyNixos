# Boot splash: Plymouth with the "rice-pond" script theme (a dark pond, two
# koi circling as the spinner, the raven perched on the rim), and a quiet boot.
# NixOS side; imported from configuration.nix.
#
# Recovery: the systemd-boot menu (5 s, unchanged) still lists the older
# generations, and Esc during the splash shows the boot messages. If the
# splash itself misbehaves, boot an older generation, or edit the entry
# ("e") and drop "quiet splash".
{ pkgs, ... }:

let
  # The art is SVG (generated by make-plymouth-art.py, plus the Umbriel
  # raven), rendered to small PNGs here.
  rice-pond = pkgs.stdenvNoCC.mkDerivation {
    pname = "plymouth-theme-rice-pond";
    version = "1.0";
    src = ./theme;
    nativeBuildInputs = [ pkgs.librsvg ];
    installPhase = ''
      dir=$out/share/plymouth/themes/rice-pond
      mkdir -p $dir
      for n in pond koi haze prompt bead; do
        rsvg-convert $n.svg -o $dir/$n.png
      done
      # The raven without its preview background.
      sed 's|<rect x="-8" y="0" width="96" height="68" fill="#0a0b0e"/>||' \
        ${../umbriel/raven-art/art.svg} > raven.svg
      rsvg-convert -w 288 raven.svg -o $dir/raven.png
      cp rice-pond.script $dir/
      cat > $dir/rice-pond.plymouth <<EOF
      [Plymouth Theme]
      Name=rice-pond
      Description=A dark pond: koi circling, the raven perched on the rim
      ModuleName=script

      [script]
      ImageDir=$dir
      ScriptFile=$dir/rice-pond.script
      EOF
      sed -i 's/^ *//' $dir/rice-pond.plymouth
    '';
  };
in
{
  boot.plymouth = {
    enable = true;
    theme = "rice-pond";
    themePackages = [ rice-pond ];
  };

  # Quiet boot: the splash instead of scrolling messages. The initrd is
  # systemd's (the only one this nixpkgs has; boot.initrd.systemd.enable is
  # gone), and it starts Plymouth early, so a disk passphrase prompt (if one
  # is ever added) shows on the splash's card; systemd asks on the console
  # instead if Plymouth isn't up.
  boot.consoleLogLevel = 3;
  # boot.plymouth adds "splash", and consoleLogLevel "loglevel=3".
  boot.kernelParams = [
    "quiet"
    "rd.udev.log_level=3"
    "udev.log_priority=3"
  ];
}
