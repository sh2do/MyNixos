# Generated by rice-wall (matugen). A KDE colour scheme: written to
# ~/.local/share/color-schemes/Rice.colors and to ~/.config/kdeglobals, which
# KDE apps (KColorScheme) read outside Plasma. Fonts and icons match GTK.
[General]
ColorScheme=Rice
Name=Rice (matugen)
font=Rubik,11,-1,5,50,0,0,0,0,0
fixed=JetBrainsMono Nerd Font,11,-1,5,50,0,0,0,0,0
menuFont=Rubik,11,-1,5,50,0,0,0,0,0
toolBarFont=Rubik,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Rubik,9,-1,5,50,0,0,0,0,0

[Icons]
Theme=Papirus-Dark

[KDE]
contrast=4

[ColorEffects:Disabled]
Color={{colors.surface.default.red}},{{colors.surface.default.green}},{{colors.surface.default.blue}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.surface_container.default.red}},{{colors.surface_container.default.green}},{{colors.surface_container.default.blue}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

