/* rofi theme: a wallpaper panel on the left, the list on the right.
 * colors.rasi is generated by rice-wall and also sets the panel image. */
@import "~/.cache/rice/colors.rasi"

* {
    background-color: transparent;
    text-color: @on-surface;
    spacing: 0;
}

window {
    width: 640px;
    border: 1px;
    border-color: @primary-container;
    border-radius: 16px;
    background-color: @surface;
}

mainbox {
    orientation: horizontal;
    children: [ imagebox, listbox ];
}

imagebox {
    expand: false;
    width: 220px;
    background-color: @surface-container;
}

listbox {
    padding: 18px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @surface-high;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @primary;
}

entry {
    placeholder: "search";
    placeholder-color: @outline;
    cursor: text;
}

listview {
    lines: 7;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 9px 12px;
    border-radius: 10px;
    spacing: 12px;
}

element selected {
    background-color: @primary;
    text-color: @on-primary;
}

element-icon {
    size: 22px;
}

element-text, element-icon {
    text-color: inherit;
    vertical-align: 0.5;
}
