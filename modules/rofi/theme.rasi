/* rofi theme: a wallpaper panel on the left, the list on the right, on wet glass.
 * colors.rasi is generated by rice-wall and also sets the panel image.
 * The glass is translucent (niri blurs behind it, see modules/niri/rules.kdl);
 * drips.png and drip-row.png are matugen renders of modules/theme/templates. */
/* The glass colours come from colors.rasi; these opaque stand-ins cover one
 * generated before the glass existed (it overrides them, being imported later). */
* {
    glass: @surface;
    glass-raised: @surface-high;
    glass-panel: @surface-container;
    glass-edge: @primary-container;
}

@import "~/.cache/rice/colors.rasi"

* {
    background-color: transparent;
    text-color: @on-surface;
    spacing: 0;
}

window {
    width: 640px;
    border: 1px;
    border-color: @glass-edge;
    border-radius: 16px;
    background-color: @glass;
    /* the inner gradient: a little light from above, a little shade below */
    background-image: linear-gradient(to bottom, #ffffff14, #ffffff05, #ffffff00, #00000000, #0000001f);
}

mainbox {
    orientation: vertical;
    children: [ rim, panes ];
}

/* light caught along the top rim */
rim {
    expand: false;
    padding: 1px 0 0;
    margin: 0 18px;
    background-image: linear-gradient(to right, #ffffff00, #ffffffa0, #ffffff40, #ffffff80, #ffffff00);
}

panes {
    orientation: horizontal;
    children: [ imagebox, listbox ];
}

imagebox {
    expand: false;
    width: 220px;
    background-color: @glass-panel;
}

listbox {
    orientation: vertical;
    children: [ listcol, drips ];
}

listcol {
    padding: 17px 18px 2px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

/* water run down the glass, gathered at the bottom edge (418 × 46) */
drips {
    expand: false;
    padding: 46px 0 0;
    background-image: url("~/.cache/rice/drips.png", none);
}

inputbar {
    padding: 9px 13px;
    border: 1px;
    border-color: @glass-edge;
    border-radius: 10px;
    background-color: @glass-raised;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @primary;
}

entry {
    placeholder: "search";
    placeholder-color: @outline;
    cursor: text;
}

listview {
    lines: 7;
    spacing: 0;
    scrollbar: false;
}

/* 44 px rows: a 38 px pill and room below it for the selected row's drop */
element {
    padding: 8px 12px 14px;
    border-radius: 10px;
    spacing: 12px;
}

element selected {
    background-image: url("~/.cache/rice/drip-row.png", both);
    text-color: @on-primary;
}

element-icon {
    size: 22px;
}

element-text, element-icon {
    text-color: inherit;
    vertical-align: 0.5;
}
